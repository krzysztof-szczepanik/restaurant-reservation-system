<UserControl x:Class="RestaurantReservationSystem.UI.Features.InitialSetup.InitialSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#800F172A">

	<UserControl.Resources>
		<Style TargetType="RadioButton">
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<StackPanel Orientation="Horizontal" Background="Transparent">
							<Grid Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
								<Ellipse x:Name="OuterRing" Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"/>
								<Ellipse x:Name="InnerDot" Fill="#2563EB" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
							</Grid>
							<ContentPresenter VerticalAlignment="Center" Margin="0,1,0,0"/>
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="OuterRing" Property="Stroke" Value="#2563EB"/>
								<Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="OuterRing" Property="Stroke" Value="#2563EB"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
		<Border Background="{StaticResource Surface}" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Width="800">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20">
					<TextBlock Text="Initial Setup" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
				</Border>

				<StackPanel Grid.Row="1" Margin="24,24,24,24">
					<TextBlock Text="Welcome to Restaurant Reservation System!" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,12"/>
					<TextBlock FontSize="14" Foreground="{StaticResource SecondaryText}" LineHeight="22" Margin="0,0,0,4" TextWrapping="Wrap">
                        Before you start, choose which reservation and table fields should be visible and required.
					</TextBlock>
					<TextBlock FontSize="14" Foreground="{StaticResource SecondaryText}" LineHeight="22" TextWrapping="Wrap">
                        These settings can only be configured once. To change them later, you will need to reset the application, which deletes all saved data.
					</TextBlock>
				</StackPanel>

				<Grid Grid.Row="2" Margin="24,0,24,24">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="32"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="RESERVATION FIELDS" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,16"/>
						<Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Field" FontSize="14" Foreground="{StaticResource SecondaryText}"/>
								<TextBlock Grid.Column="1" Text="Visible" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="2" Text="Required" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
							</Grid>
						</Border>

						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="First name" FontSize="14" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="1" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="2" IsChecked="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>

						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="Last name" FontSize="14" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="1" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="2" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>

						<Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Phone number" FontSize="14" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
								<CheckBox Grid.Column="1" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<CheckBox Grid.Column="2" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Grid>
						</Border>

						<TextBlock Text="At least one contact field must be visible and required." 
                                   FontSize="12" 
                                   Foreground="#DC2626" 
                                   TextWrapping="Wrap" 
                                   Visibility="Collapsed"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="TABLE FIELDS" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,16"/>
						<Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Field" FontSize="14" Foreground="{StaticResource SecondaryText}"/>
								<TextBlock Grid.Column="1" Text="Visible" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="2" Text="Required" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
							</Grid>
						</Border>

						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="Number" FontSize="14" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="1" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="2" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>

						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="Label" FontSize="14" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="1" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<CheckBox Grid.Column="2" IsChecked="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>

						<Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Zone" FontSize="14" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
								<CheckBox Grid.Column="1" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<CheckBox Grid.Column="2" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Grid>
						</Border>

						<TextBlock Text="At least one of Number or Label must be visible and required." 
                                   FontSize="12" 
                                   Foreground="#DC2626" 
                                   TextWrapping="Wrap" 
                                   Visibility="Collapsed"/>
					</StackPanel>
				</Grid>

				<StackPanel Grid.Row="3" Margin="24,0,24,32">
					<TextBlock Text="TABLE IDENTIFIER ORDER" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,16"/>
					<RadioButton Content="Number → Label (e.g., 1A, 2B)" IsChecked="True" Margin="0,0,0,12" FontSize="14"/>
					<RadioButton Content="Label → Number (e.g., A1, B2)" FontSize="14"/>
				</StackPanel>

				<Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Save" Width="88" Height="36" Click="Submit_Click" 
                                Background="{StaticResource Primary}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>