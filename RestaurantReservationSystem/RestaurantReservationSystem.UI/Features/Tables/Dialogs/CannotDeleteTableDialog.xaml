<UserControl x:Class="RestaurantReservationSystem.UI.Features.Tables.Dialogs.CannotDeleteTableDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">

	<controls:Dialog Header="Cannot Delete Table" Width="480">

		<!-- CONTENT -->
		<controls:Dialog.DialogContent>
			<StackPanel>
				<TextBlock Text="This table cannot be deleted" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
				<TextBlock Text="Because it is assigned to reservations." FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
			</StackPanel>
		</controls:Dialog.DialogContent>

		<!-- FOOTER RIGHT -->
		<controls:Dialog.FooterRight>
			<Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click"/>
		</controls:Dialog.FooterRight>

	</controls:Dialog>
</UserControl>