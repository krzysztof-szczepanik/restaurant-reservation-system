<UserControl x:Class="RestaurantReservationSystem.UI.Features.Tables.Dialogs.AddEditTableDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">

    <UserControl.Resources>

        <!-- TEXTBOX -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SPINNER TEXTBOX -->
        <Style x:Key="SpinnerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- EDITABLE COMBOBOX -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>

                            <!-- SELECTED TEXT -->
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,36,0" VerticalAlignment="Center"/>

                            <!-- EDITABLE TEXT -->
                            <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource SpinnerTextBoxStyle}" Margin="0,0,36,0" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <!-- DROPDOWN BUTTON -->
                            <ToggleButton Width="32" HorizontalAlignment="Right" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M1 1 L5 5 L9 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- DROPDOWN -->
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="6" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SPINNER BORDER -->
        <Style x:Key="SpinnerBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SPINNER BUTTON -->
        <Style x:Key="SpinnerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <controls:Dialog x:Name="TableDialog" Header="Add Table" Width="480">

        <!-- CONTENT -->
        <controls:Dialog.DialogContent>
            <StackPanel>

                <!-- NUMBER -->
                <TextBlock Text="Number *" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>

                <Border x:Name="NumberBorder" Style="{StaticResource SpinnerBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NumberBox" Text="5" Style="{StaticResource SpinnerTextBoxStyle}"/>

                        <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Click="NumberUp_Click">
                                    <Path Data="M2 4 L5 1 L8 4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                    <Button Style="{StaticResource SpinnerButtonStyle}" Click="NumberDown_Click">
                                        <Path Data="M2 1 L5 4 L8 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="Enter a number greater than 0." FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,0,12" Visibility="Collapsed"/>

                <!-- LABEL -->
                <TextBlock Text="Label" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
                <TextBox x:Name="LabelBox" Text="E" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,4"/>
                <TextBlock Text="Use letters A-Z only." FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,0,12" Visibility="Collapsed"/>

                <!-- ZONE -->
                <TextBlock Text="Zone" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="ZoneBox" Style="{StaticResource FormComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="False" Margin="0,0,0,16"/>

                <!-- SEATS -->
                <TextBlock Text="Seats *" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>

                <Border x:Name="SeatsBorder" Style="{StaticResource SpinnerBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SeatsBox" Text="4" Style="{StaticResource SpinnerTextBoxStyle}"/>

                        <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Click="SeatsUp_Click">
                                    <Path Data="M2 4 L5 1 L8 4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                    <Button Style="{StaticResource SpinnerButtonStyle}" Click="SeatsDown_Click">
                                        <Path Data="M2 1 L5 4 L8 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="This field is required." FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,0,4" Visibility="Collapsed"/>

            </StackPanel>
        </controls:Dialog.DialogContent>

        <!-- FOOTER RIGHT -->
        <controls:Dialog.FooterRight>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Add" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
            </StackPanel>
        </controls:Dialog.FooterRight>

    </controls:Dialog>
</UserControl>