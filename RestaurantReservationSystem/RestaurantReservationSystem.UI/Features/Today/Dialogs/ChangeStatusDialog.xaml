<UserControl x:Class="RestaurantReservationSystem.UI.Features.Today.Dialogs.ChangeStatusDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">
	<controls:Dialog Header="Change Status" Width="480">
		<controls:Dialog.DialogContent>
			<StackPanel>
				<TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
				<TextBlock Text="This action will deactivate the reservation. This cannot be undone." FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
			</StackPanel>
		</controls:Dialog.DialogContent>
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
				<Button Content="Confirm" Style="{StaticResource DangerButtonStyle}" Click="Confirm_Click"/>
			</StackPanel>
		</controls:Dialog.FooterRight>
	</controls:Dialog>
</UserControl>