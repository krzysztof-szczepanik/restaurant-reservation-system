<UserControl x:Class="RestaurantReservationSystem.UI.Features.Reservations.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="992">

    <Grid Background="Transparent" MouseDown="MainGrid_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource ViewHeaderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE AND ACTIONS -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Reservations" Style="{StaticResource ViewTitleStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Add" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="AddReservations_Click"/>
                        <Button Content="Edit" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="EditReservations_Click"/>
                        <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteReservations_Click"/>
                    </StackPanel>
                </Grid>

                <!-- SEARCH AND FILTER -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH -->
                    <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchTextBoxStyle}"/>

                    <!-- FILTER -->
                    <Button x:Name="FilterButton" Grid.Column="2" Content="Filter" Tag="False" Style="{StaticResource FilterButtonStyle}" Click="Filter_Click"/>
                </Grid>
            </Grid>
        </Border>


        <!-- CONTENT -->
        <Border Grid.Row="1" Style="{StaticResource ViewContentStyle}">
            <controls:DataTable x:Name="ReservationsDataGrid" EmptyMessage="No reservations yet.">
                <controls:DataTable.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:hh\:mm}}"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}"/>
                    <DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneNumber}"/>
                    <DataGridTextColumn Header="Guests" Binding="{Binding Guests}"/>
                    <DataGridTextColumn Header="Tables" Binding="{Binding Tables}"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}"/>
                </controls:DataTable.Columns>
            </controls:DataTable>
        </Border>
    </Grid>
</UserControl>