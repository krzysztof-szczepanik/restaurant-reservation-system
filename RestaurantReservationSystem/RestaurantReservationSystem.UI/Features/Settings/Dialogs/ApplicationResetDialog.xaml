<UserControl x:Class="RestaurantReservationSystem.UI.Features.Settings.Dialogs.ApplicationResetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">

    <controls:Dialog Header="Reset Application" Width="480">

        <!-- CONTENT -->
        <controls:Dialog.DialogContent>
            <StackPanel>
                <TextBlock Text="Are you sure you want to reset the application?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="This action will permanently delete all reservations, tables, and the initial configuration. This cannot be undone." FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
        </controls:Dialog.DialogContent>

        <!-- FOOTER RIGHT -->
        <controls:Dialog.FooterRight>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button Content="Reset" Style="{StaticResource DangerButtonStyle}" Click="Reset_Click"/>
            </StackPanel>
        </controls:Dialog.FooterRight>

    </controls:Dialog>
</UserControl>