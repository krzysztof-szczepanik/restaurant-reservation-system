<UserControl x:Class="RestaurantReservationSystem.UI.Features.Today.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:enums="clr-namespace:RestaurantReservationSystem.Core.Enums;assembly=RestaurantReservationSystem.Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="992">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<Border Grid.Row="0" Style="{StaticResource ViewHeaderStyle}">
			<Grid>
				<TextBlock Text="Today" Style="{StaticResource ViewTitleStyle}"/>
				<TextBlock x:Name="TodayDateText" FontSize="18" FontWeight="SemiBold"
				           HorizontalAlignment="Right" VerticalAlignment="Center"
				           Foreground="{StaticResource PrimaryText}"/>
			</Grid>
		</Border>

		<!-- CONTENT -->
		<Border Grid.Row="1" Style="{StaticResource ViewContentStyle}">
			<controls:DataTable x:Name="ReservationsTable"
			                    ItemsSource="{Binding TodayReservations}"
			                    EmptyMessage="No reservations today."
			                    PreviewMouseLeftButtonDown="ReservationsTable_PreviewMouseLeftButtonDown"
			                    SelectionChanged="ReservationsTable_SelectionChanged">

				<controls:DataTable.Columns>
					<DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}"/>
					<DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}"/>
					<DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Visibility="Collapsed"/>
					<DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Visibility="Collapsed"/>
					<DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneDisplay}" Visibility="Collapsed"/>
					<DataGridTextColumn Header="Guests" Binding="{Binding Guests}"/>
					<DataGridTextColumn Header="Tables" Binding="{Binding TablesDisplay}">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="ToolTip" Value="{Binding TablesTooltip}"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Header="Note" Binding="{Binding NoteDisplay}">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="ToolTip" Value="{Binding NoteTooltip}"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>

					<DataGridTemplateColumn Header="Status" Width="140">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ComboBox Width="116" Height="30" HorizontalAlignment="Left"
								          ItemsSource="{Binding StatusOptions}"
								          SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								          SelectionChanged="StatusComboBox_SelectionChanged"
								          Background="{Binding StatusBackground}"
								          BorderBrush="{Binding StatusBorder}"
								          Foreground="{Binding StatusForeground}"
								          FontSize="12" FontWeight="SemiBold"
								          VerticalContentAlignment="Center" Padding="8,0">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<StackPanel>
												<Separator Margin="0,2,0,4" Visibility="{Binding ShowSeparatorBefore, Converter={StaticResource BooleanToVisibilityConverter}}" />
												<TextBlock Text="{Binding Label}" FontSize="12"
												           FontWeight="{Binding IsUnlockAction, Converter={StaticResource BooleanToBoldConverter}}" />
											</StackPanel>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</controls:DataTable.Columns>

			</controls:DataTable>
		</Border>
	</Grid>
</UserControl>