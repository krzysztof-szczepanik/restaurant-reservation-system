<Window x:Class="RestaurantReservationSystem.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Rezerwacji Restauracyjnych" 
        Height="768" Width="1024"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="{StaticResource Surface}" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="System zarządzania rezerwacjami dla restauracji"
                   TextWrapping="Wrap"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="24,24,24,32"/>

                <StackPanel Grid.Row="1" Margin="12,0">

                    <RadioButton Content="Dzisiaj" 
                                 Style="{StaticResource SidebarButtonStyle}" 
                                 IsChecked="True"
                                 Checked="Menu_Today_Checked"/>

                    <RadioButton Content="Rezerwacje" 
                                 Style="{StaticResource SidebarButtonStyle}"
                                 Checked="Menu_Reservations_Checked"/>

                    <RadioButton Content="Stoliki" 
                                 Style="{StaticResource SidebarButtonStyle}"
                                 Checked="Menu_Stoliki_Checked"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12,0,12,24">
                    <RadioButton Content="Ustawienia" 
                                 Style="{StaticResource SidebarButtonStyle}"
                                 Checked="Menu_Ustawienia_Checked"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContentArea" 
                        Grid.Column="1" 
                        Margin="24"/>
    </Grid>
</Window>