<UserControl x:Class="RestaurantReservationSystem.UI.Features.Today.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,0">
            <TextBlock Text="Dzisiejszy przegląd" 
                       FontSize="32" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center"/>

            <TextBlock Text="Niedziela, Pażdziernik 25, 2026" 
                       FontSize="16" 
                       Foreground="{StaticResource SecondaryText}" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="{StaticResource Surface}" 
                    BorderBrush="{StaticResource Border}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Nadchodzące rezerwacje" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="1" 
                               Text="Brak nadchodzących rezerwacji na dzisiaj" 
                               Foreground="{StaticResource SecondaryText}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" 
                    Background="{StaticResource Surface}" 
                    BorderBrush="{StaticResource Border}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Status stolików" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="1" 
                               Text="Wszystkie stoliki są obecnie dostępne" 
                               Foreground="{StaticResource SecondaryText}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>