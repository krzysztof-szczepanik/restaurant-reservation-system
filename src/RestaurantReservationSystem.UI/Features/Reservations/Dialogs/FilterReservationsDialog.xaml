<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.FilterReservationsDialog"
             PreviewKeyDown="UserControl_PreviewKeyDown">

	<controls:Dialog Header="Filter Reservations" Width="520" MinWidth="440">

		<!-- CONTENT -->
		<controls:Dialog.DialogContent>
			<ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel>

					<!-- DATE -->
					<Grid Margin="0,0,0,6">
						<TextBlock Text="Date" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />

						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Button x:Name="DateExactModeButton" Content="Exact" FontSize="11" FontWeight="SemiBold"
								        Foreground="{StaticResource Primary}" Background="{StaticResource Surface}"
								        BorderThickness="0" Padding="8,3" Cursor="Hand" Click="DateMode_Click" />
								<Button x:Name="DateRangeModeButton" Content="Range" FontSize="11"
								        Foreground="{StaticResource SecondaryText}" Background="Transparent"
								        BorderThickness="0" Padding="8,3" Cursor="Hand" Click="DateMode_Click" />
							</StackPanel>
						</Border>
					</Grid>

					<StackPanel x:Name="DateExactPanel" Margin="0,0,0,16">
						<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
						<Grid Height="36">
							<TextBox x:Name="FDateExactBox" VerticalContentAlignment="Center" Padding="12,0,36,0"
							         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
							         TextChanged="FilterField_TextChanged" />
							<TextBlock Text="dd.MM.yyyy" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
							           Margin="13,0,36,0" IsHitTestVisible="False" FontSize="12">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=FDateExactBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FDateExactBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
								<Canvas Width="24" Height="24">
									<Path Stroke="#94A3B8" StrokeThickness="2" StrokeLineJoin="Round"
									      Data="M4 7C4 5.89543 4.89543 5 6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7Z" />
									<Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
									      Data="M16 3V7M8 3V7M4 11H20" />
								</Canvas>
							</Viewbox>
						</Grid>
						<TextBlock x:Name="DateExactErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
					</StackPanel>

					<StackPanel x:Name="DateRangePanel" Margin="0,0,0,16" Visibility="Collapsed">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="From" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
								<Grid Height="36">
									<TextBox x:Name="FDateFromBox" VerticalContentAlignment="Center" Padding="12,0,36,0"
									         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
									         TextChanged="FilterField_TextChanged" />
									<TextBlock Text="dd.MM.yyyy" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
									           Margin="13,0,36,0" IsHitTestVisible="False" FontSize="12">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Text, ElementName=FDateFromBox}" Value=""/>
															<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FDateFromBox}" Value="False"/>
														</MultiDataTrigger.Conditions>
														<Setter Property="Visibility" Value="Visible"/>
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
										<Canvas Width="24" Height="24">
											<Path Stroke="#94A3B8" StrokeThickness="2" StrokeLineJoin="Round"
											      Data="M4 7C4 5.89543 4.89543 5 6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7Z" />
											<Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
											      Data="M16 3V7M8 3V7M4 11H20" />
										</Canvas>
									</Viewbox>
								</Grid>
								<TextBlock x:Name="DateFromErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="To" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
								<Grid Height="36">
									<TextBox x:Name="FDateToBox" VerticalContentAlignment="Center" Padding="12,0,36,0"
									         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
									         TextChanged="FilterField_TextChanged" />
									<TextBlock Text="dd.MM.yyyy" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
									           Margin="13,0,36,0" IsHitTestVisible="False" FontSize="12">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Text, ElementName=FDateToBox}" Value=""/>
															<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FDateToBox}" Value="False"/>
														</MultiDataTrigger.Conditions>
														<Setter Property="Visibility" Value="Visible"/>
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
										<Canvas Width="24" Height="24">
											<Path Stroke="#94A3B8" StrokeThickness="2" StrokeLineJoin="Round"
											      Data="M4 7C4 5.89543 4.89543 5 6 5H18C19.1046 5 20 5.89543 20 7V19C20 20.1046 19.1046 21 18 21H6C4.89543 21 4 20.1046 4 19V7Z" />
											<Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
											      Data="M16 3V7M8 3V7M4 11H20" />
										</Canvas>
									</Viewbox>
								</Grid>
								<TextBlock x:Name="DateToErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
							</StackPanel>
						</Grid>
					</StackPanel>


					<!-- TIME -->
					<Grid Margin="0,0,0,6">
						<TextBlock Text="Time" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />

						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Button x:Name="TimeExactModeButton" Content="Exact" FontSize="11" FontWeight="SemiBold"
								        Foreground="{StaticResource Primary}" Background="{StaticResource Surface}"
								        BorderThickness="0" Padding="8,3" Cursor="Hand" Click="TimeMode_Click" />
								<Button x:Name="TimeRangeModeButton" Content="Range" FontSize="11"
								        Foreground="{StaticResource SecondaryText}" Background="Transparent"
								        BorderThickness="0" Padding="8,3" Cursor="Hand" Click="TimeMode_Click" />
							</StackPanel>
						</Border>
					</Grid>

					<StackPanel x:Name="TimeExactPanel" Margin="0,0,0,16">
						<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
						<Grid Height="36">
							<TextBox x:Name="FTimeExactBox" VerticalContentAlignment="Center" Padding="12,0,36,0"
							         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
							         TextChanged="FilterField_TextChanged" />
							<TextBlock Text="HH:mm" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
							           Margin="13,0,36,0" IsHitTestVisible="False" FontSize="12">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=FTimeExactBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FTimeExactBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
								<Canvas Width="24" Height="24">
									<Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3" Stroke="#94A3B8" StrokeThickness="2" />
									<Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
									      Data="M12 7V12L15.5 14" />
								</Canvas>
							</Viewbox>
						</Grid>
						<TextBlock x:Name="TimeExactErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
					</StackPanel>

					<StackPanel x:Name="TimeRangePanel" Margin="0,0,0,16" Visibility="Collapsed">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="From" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
								<Grid Height="36">
									<TextBox x:Name="FTimeFromBox" VerticalContentAlignment="Center" Padding="12,0,36,0"
									         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
									         TextChanged="FilterField_TextChanged" />
									<TextBlock Text="HH:mm" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
									           Margin="13,0,36,0" IsHitTestVisible="False" FontSize="12">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Text, ElementName=FTimeFromBox}" Value=""/>
															<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FTimeFromBox}" Value="False"/>
														</MultiDataTrigger.Conditions>
														<Setter Property="Visibility" Value="Visible"/>
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
										<Canvas Width="24" Height="24">
											<Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3" Stroke="#94A3B8" StrokeThickness="2" />
											<Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
											      Data="M12 7V12L15.5 14" />
										</Canvas>
									</Viewbox>
								</Grid>
								<TextBlock x:Name="TimeFromErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="To" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
								<Grid Height="36">
									<TextBox x:Name="FTimeToBox" VerticalContentAlignment="Center" Padding="12,0,36,0"
									         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
									         TextChanged="FilterField_TextChanged" />
									<TextBlock Text="HH:mm" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"
									           Margin="13,0,36,0" IsHitTestVisible="False" FontSize="12">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Text, ElementName=FTimeToBox}" Value=""/>
															<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FTimeToBox}" Value="False"/>
														</MultiDataTrigger.Conditions>
														<Setter Property="Visibility" Value="Visible"/>
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Viewbox Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
										<Canvas Width="24" Height="24">
											<Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3" Stroke="#94A3B8" StrokeThickness="2" />
											<Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
											      Data="M12 7V12L15.5 14" />
										</Canvas>
									</Viewbox>
								</Grid>
								<TextBlock x:Name="TimeToErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
							</StackPanel>
						</Grid>
					</StackPanel>


					<!-- GUESTS -->
					<Grid Margin="0,0,0,6">
						<TextBlock Text="Guests" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />

						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Button x:Name="GuestsExactModeButton" Content="Exact" FontSize="11" FontWeight="SemiBold"
								        Foreground="{StaticResource Primary}" Background="{StaticResource Surface}"
								        BorderThickness="0" Padding="8,3" Cursor="Hand" Click="GuestsMode_Click" />
								<Button x:Name="GuestsRangeModeButton" Content="Range" FontSize="11"
								        Foreground="{StaticResource SecondaryText}" Background="Transparent"
								        BorderThickness="0" Padding="8,3" Cursor="Hand" Click="GuestsMode_Click" />
							</StackPanel>
						</Border>
					</Grid>

					<StackPanel x:Name="GuestsExactPanel" Margin="0,0,0,16">
						<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
						<TextBox x:Name="FGuestsExactBox" Height="36" VerticalContentAlignment="Center" Padding="12,0"
						         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
						         TextChanged="FilterField_TextChanged" />
						<TextBlock x:Name="GuestsExactErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
					</StackPanel>

					<StackPanel x:Name="GuestsRangePanel" Margin="0,0,0,16" Visibility="Collapsed">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="From" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
								<TextBox x:Name="FGuestsFromBox" Height="36" VerticalContentAlignment="Center" Padding="12,0"
								         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
								         TextChanged="FilterField_TextChanged" />
								<TextBlock x:Name="GuestsFromErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="To" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
								<TextBox x:Name="FGuestsToBox" Height="36" VerticalContentAlignment="Center" Padding="12,0"
								         Foreground="{StaticResource PrimaryText}" Style="{StaticResource ReservationFormTextBoxStyle}"
								         TextChanged="FilterField_TextChanged" />
								<TextBlock x:Name="GuestsToErrorText" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed" />
							</StackPanel>
						</Grid>
					</StackPanel>


					<!-- ZONE -->
					<StackPanel x:Name="ZoneFilterSection" Margin="0,0,0,16">
						<Grid Margin="0,0,0,8">
							<TextBlock Text="Zone" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />

							<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
								<StackPanel Orientation="Horizontal">
									<Button x:Name="ZoneOrButton" Content="OR" FontSize="11" FontWeight="SemiBold"
									        Foreground="{StaticResource Primary}" Background="{StaticResource Surface}"
									        BorderThickness="0" Padding="10,3" Cursor="Hand" Click="ZoneMatchMode_Click" />
									<Button x:Name="ZoneAndButton" Content="AND" FontSize="11"
									        Foreground="{StaticResource SecondaryText}" Background="Transparent"
									        BorderThickness="0" Padding="10,3" Cursor="Hand" Click="ZoneMatchMode_Click" />
								</StackPanel>
							</Border>
						</Grid>

						<Grid Height="52">
							<Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12,0">
								<TextBlock x:Name="SelectedZonesText" Text="Selected zones: 0" VerticalAlignment="Center"
								           Foreground="{StaticResource PrimaryText}" FontSize="13" FontWeight="SemiBold" />
							</Border>

							<Button Content="Select Zones"
							        HorizontalAlignment="Right"
							        VerticalAlignment="Center"
							        Height="36"
							        Margin="0,0,6,0"
							        Background="{StaticResource Surface}"
							        Foreground="{StaticResource PrimaryText}"
							        BorderBrush="{StaticResource Border}"
							        Style="{StaticResource SecondaryButtonStyle}"
							        Click="SelectZones_Click" />
						</Grid>
					</StackPanel>


					<!-- TABLES -->
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<TextBlock Text="Tables" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />

							<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
								<StackPanel Orientation="Horizontal">
									<Button x:Name="TablesOrButton" Content="OR" FontSize="11" FontWeight="SemiBold"
									        Foreground="{StaticResource Primary}" Background="{StaticResource Surface}"
									        BorderThickness="0" Padding="10,3" Cursor="Hand" Click="TablesMatchMode_Click" />
									<Button x:Name="TablesAndButton" Content="AND" FontSize="11"
									        Foreground="{StaticResource SecondaryText}" Background="Transparent"
									        BorderThickness="0" Padding="10,3" Cursor="Hand" Click="TablesMatchMode_Click" />
								</StackPanel>
							</Border>
						</Grid>

						<Grid Height="52">
							<Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12,0">
								<TextBlock x:Name="SelectedTablesText" Text="Selected tables: 0" VerticalAlignment="Center"
								           Foreground="{StaticResource PrimaryText}" FontSize="13" FontWeight="SemiBold" />
							</Border>

							<Button Content="Select Tables"
							        HorizontalAlignment="Right"
							        VerticalAlignment="Center"
							        Height="36"
							        Margin="0,0,6,0"
							        Background="{StaticResource Surface}"
							        Foreground="{StaticResource PrimaryText}"
							        BorderBrush="{StaticResource Border}"
							        Style="{StaticResource SecondaryButtonStyle}"
							        Click="SelectTables_Click" />
						</Grid>
					</StackPanel>

					<TextBlock x:Name="GeneralFilterErrorText" FontSize="11" Foreground="#EF4444" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

				</StackPanel>
			</ScrollViewer>
		</controls:Dialog.DialogContent>


		<!-- FOOTER LEFT -->
		<controls:Dialog.FooterLeft>
			<Button Content="Reset"
			        Height="36"
			        HorizontalAlignment="Left"
			        Background="{StaticResource Surface}"
			        Foreground="{StaticResource PrimaryText}"
			        BorderBrush="{StaticResource Border}"
			        Click="Reset_Click"
			        Style="{StaticResource SecondaryButtonStyle}" />
		</controls:Dialog.FooterLeft>

		<!-- FOOTER RIGHT -->
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel"
				        Height="36"
				        Margin="0,0,8,0"
				        Background="{StaticResource Surface}"
				        Foreground="{StaticResource PrimaryText}"
				        BorderBrush="{StaticResource Border}"
				        Style="{StaticResource SecondaryButtonStyle}"
				        Click="Cancel_Click" />
				<Button x:Name="ApplyButton"
				        Content="Apply"
				        Height="36"
				        Click="Apply_Click"
				        Style="{StaticResource PrimaryButtonStyle}" />
			</StackPanel>
		</controls:Dialog.FooterRight>

	</controls:Dialog>
</UserControl>