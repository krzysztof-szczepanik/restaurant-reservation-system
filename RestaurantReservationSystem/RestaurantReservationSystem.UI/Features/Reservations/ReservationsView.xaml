<UserControl x:Class="RestaurantReservationSystem.UI.Features.Reservations.ResView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource Background}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Rezerwacje" 
                       FontSize="32" 
                       FontWeight="SemiBold"/>

            <TextBox Grid.Row="1" Grid.Column="0" 
                     Width="250" 
                     HorizontalAlignment="Left" 
                     Margin="0,8,0,0"/>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Dodaj" Width="88" Margin="0,0,8,0" Click="AddRes_Click"/>

                <Button Content="Edytuj" Width="88" Margin="0,0,8,0" Click="EditRes_Click"
                        Background="{StaticResource Surface}" 
                        Foreground="{StaticResource Text}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"/>

                <Button Content="Usuń" Width="88" Click="DeleteRes_Click"
                        Background="{StaticResource Surface}" 
                        Foreground="{StaticResource Text}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"/>
            </StackPanel>

            <Button Grid.Row="1" Grid.Column="1" 
                    Content="Filtruj" 
                    Background="Transparent" 
                    Foreground="{StaticResource Text}" 
                    BorderThickness="0" 
                    HorizontalAlignment="Right" 
                    Margin="0,8,0,0" 
                    Click="Filter_Click"/>
        </Grid>

        <DataGrid x:Name="ResDataGrid" 
                  Grid.Row="1" Margin="24,16,24,24" 
                  AutoGenerateColumns="False" 
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Border}"
                  BorderThickness="1"
                  RowHeight="52"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Border}"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*"/>
                <DataGridTextColumn Header="Godzina" Binding="{Binding Godzina}" Width="1.2*"/>
                <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="1.5*"/>
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" Width="1.5*"/>
                <DataGridTextColumn Header="Numer telefonu" Binding="{Binding NumerTelefonu}" Width="2*"/>
                <DataGridTextColumn Header="Osoby" Binding="{Binding LiczbaOsob}" Width="*"/>
                <DataGridTextColumn Header="Stoliki" Binding="{Binding Stolik}" Width="1.5*"/>
                <DataGridTextColumn Header="Notatka" Binding="{Binding Notatka}" Width="2.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyStateText"
                   Grid.Row="1"
                   Text="Brak rezerwacji" 
                   Foreground="{StaticResource SecondaryText}"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Visibility="Visible"/>
    </Grid>
</UserControl>