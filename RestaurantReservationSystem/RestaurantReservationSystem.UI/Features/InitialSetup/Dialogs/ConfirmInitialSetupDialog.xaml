<UserControl x:Class="RestaurantReservationSystem.UI.Features.InitialSetup.Dialogs.ConfirmInitialSetupDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">

    <!-- DIALOG -->
    <controls:Dialog Header="Confirm Initial Setup" Width="480">

        <!-- CONTENT -->
        <controls:Dialog.DialogContent>
            <StackPanel>
                <TextBlock Text="Are you sure you want to save this configuration?" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="These settings cannot be changed later without resetting the application and deleting all saved data." FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
        </controls:Dialog.DialogContent>

        <!-- FOOTER RIGHT -->
        <controls:Dialog.FooterRight>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button Content="Confirm" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
            </StackPanel>
        </controls:Dialog.FooterRight>

    </controls:Dialog>
</UserControl>