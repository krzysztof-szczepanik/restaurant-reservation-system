<Window x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.SelectZonesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" 
        Background="Transparent" 
        AllowsTransparency="True" 
        SizeToContent="WidthAndHeight">

	<Grid Background="#660F172A">
		<Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="480">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20">
					<TextBlock Text="Select Zones" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryText}"/>
				</Border>

				<StackPanel Grid.Row="1" Margin="24,20,24,16">
					<TextBox Height="36" 
                             VerticalContentAlignment="Center" 
                             Padding="12,0" 
                             Foreground="{StaticResource SecondaryText}" 
                             Text="Search zones" 
                             Margin="0,0,0,16"/>

					<Border Background="{StaticResource Surface}" 
                            BorderBrush="{StaticResource Border}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12" 
                            Height="220">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<Border Background="#EFF6FF" CornerRadius="4" Padding="8,8" Margin="0,0,0,4">
									<CheckBox Content="Main Hall" IsChecked="True" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
								</Border>
								<Border Background="Transparent" CornerRadius="4" Padding="8,8" Margin="0,0,0,4">
									<CheckBox Content="Terrace" IsChecked="False" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
								</Border>
								<Border Background="Transparent" CornerRadius="4" Padding="8,8">
									<CheckBox Content="No zone" IsChecked="False" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Border>
				</StackPanel>

				<TextBlock Grid.Row="2" Text="Selected zones: 1" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryText}" 
                           Margin="24,0,24,16" 
                           HorizontalAlignment="Left"/>

				<Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Cancel" Width="72" Height="36" Margin="0,0,8,0" 
                                Background="{StaticResource Surface}" 
                                Foreground="{StaticResource PrimaryText}" 
                                BorderBrush="{StaticResource Border}" 
                                BorderThickness="1" 
                                Click="Cancel_Click"/>

						<Button Content="Confirm" Width="72" Height="36" 
                                Background="{StaticResource Primary}" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Click="Confirm_Click"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>