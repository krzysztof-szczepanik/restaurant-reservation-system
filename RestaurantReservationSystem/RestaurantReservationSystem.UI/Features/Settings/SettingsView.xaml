<UserControl x:Class="RestaurantReservationSystem.UI.Features.Ustawienia.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#F1F5F9">

	<StackPanel>

		<Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                Margin="24,24,24,16" 
                Padding="24,20">
			<TextBlock Text="Settings" 
                       FontSize="22" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource PrimaryText}"/>
		</Border>

		<Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                Margin="24,0,24,24" 
                Padding="24" Height="550">

			<StackPanel>
				<TextBlock Text="RESET APPLICATION" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryText}" 
                           Margin="0,0,0,16"/>

				<TextBlock Text="Resetting the application permanently deletes all reservations, tables, and the initial configuration." 
                           FontSize="13" 
                           Foreground="{StaticResource SecondaryText}" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

				<TextBlock Text="After the reset, the application will return to Initial Setup." 
                           FontSize="13" 
                           Foreground="{StaticResource SecondaryText}" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

				<Button Content="Reset Application" 
                        Width="140" 
                        Height="36" 
                        HorizontalAlignment="Right"
                        Background="Transparent" 
                        Foreground="#DC2626"
                        BorderBrush="#DC2626"
                        BorderThickness="1"
                        Click="Reset_Click"/>
			</StackPanel>
		</Border>

	</StackPanel>
</UserControl>