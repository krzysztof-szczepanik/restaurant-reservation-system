<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.AddEditReservationDialog"
             PreviewKeyDown="UserControl_PreviewKeyDown">

	<UserControl.Resources>

		<!-- SPINNER TEXTBOX -->
		<Style x:Key="SpinnerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReservationFormTextBoxStyle}">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<!-- SPINNER BORDER -->
		<Style x:Key="SpinnerBorderStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource Surface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Height" Value="36"/>
			<Style.Triggers>
				<Trigger Property="IsKeyboardFocusWithin" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- SPINNER BUTTON -->
		<Style x:Key="SpinnerButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{DynamicResource SecondaryHover}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- SELECT TABLES BUTTON STYLE -->
		<Style x:Key="SelectTablesActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
			<Setter Property="Foreground" Value="#334155"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Opacity" Value="1"/>
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Foreground" Value="#8A99AD"/>
					<Setter Property="BorderBrush" Value="#DCE3EC"/>
					<Setter Property="Background" Value="#F8FAFC"/>
					<Setter Property="Opacity" Value="1"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- VALIDATION ERROR TEXT -->
		<Style x:Key="FieldErrorTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Danger}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="0,4,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Visibility" Value="Collapsed"/>
		</Style>

	</UserControl.Resources>


	<controls:Dialog x:Name="ReservationDialog" Header="Add Reservation" Width="520">

		<!-- CONTENT -->
		<controls:Dialog.DialogContent>
			<StackPanel>

				<!-- DATE AND TIME -->
				<Grid Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- DATE -->
					<StackPanel Grid.Column="0">
						<TextBlock Text="Date *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />

						<Grid>
							<TextBox x:Name="DateBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,32,0"
                                     Style="{StaticResource ReservationFormTextBoxStyle}"
                                     TextChanged="DateOrTimeBox_TextChanged" />

							<TextBlock Text="dd.MM.yyyy" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=DateBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DateBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<Path Data="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M2 2a1 1 0 0 0-1 1v1h14V3a1 1 0 0 0-1-1zm13 3H1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1z" Fill="{StaticResource SecondaryText}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
						</Grid>

						<TextBlock x:Name="DateErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					</StackPanel>

					<!-- TIME -->
					<StackPanel Grid.Column="2">
						<TextBlock Text="Time *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />

						<Grid>
							<TextBox x:Name="TimeBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,32,0"
                                     Style="{StaticResource ReservationFormTextBoxStyle}"
                                     TextChanged="DateOrTimeBox_TextChanged" />

							<TextBlock Text="HH:mm" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=TimeBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TimeBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Fill="{StaticResource SecondaryText}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
						</Grid>

						<TextBlock x:Name="TimeErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					</StackPanel>
				</Grid>


				<!-- FIRST NAME AND LAST NAME -->
				<Grid x:Name="NameRowGrid" Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition x:Name="FirstNameCol" Width="*"/>
						<ColumnDefinition x:Name="NameSpacerCol" Width="16"/>
						<ColumnDefinition x:Name="LastNameCol" Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel x:Name="FirstNamePanel" Grid.Column="0">
						<TextBlock x:Name="FirstNameLabel" Text="First Name" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
						<Grid>
							<TextBox x:Name="FirstNameBox" Height="36" VerticalContentAlignment="Center" Padding="12,0"
                                     Style="{StaticResource ReservationFormTextBoxStyle}"
                                     TextChanged="FirstNameBox_TextChanged" />
							<TextBlock Text="First name" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=FirstNameBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FirstNameBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
						<TextBlock x:Name="FirstNameErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					</StackPanel>

					<StackPanel x:Name="LastNamePanel" Grid.Column="2">
						<TextBlock x:Name="LastNameLabel" Text="Last Name" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
						<Grid>
							<TextBox x:Name="LastNameBox" Height="36" VerticalContentAlignment="Center" Padding="12,0"
                                     Style="{StaticResource ReservationFormTextBoxStyle}"
                                     TextChanged="LastNameBox_TextChanged" />
							<TextBlock Text="Last name" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=LastNameBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=LastNameBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
						<TextBlock x:Name="LastNameErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					</StackPanel>
				</Grid>


				<!-- PHONE NUMBER AND GUESTS -->
				<Grid Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition x:Name="PhoneCol" Width="*"/>
						<ColumnDefinition x:Name="PhoneGuestsSpacerCol" Width="16"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- PHONE NUMBER -->
					<StackPanel x:Name="PhonePanel" Grid.Column="0">
						<TextBlock x:Name="PhoneLabel" Text="Phone Number" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
						<Grid>
							<TextBox x:Name="PhoneBox" Height="36" VerticalContentAlignment="Center" Padding="12,0"
                                     Style="{StaticResource ReservationFormTextBoxStyle}"
                                     TextChanged="PhoneBox_TextChanged" />
							<TextBlock Text="123 456 789" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=PhoneBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PhoneBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
						<TextBlock x:Name="PhoneErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					</StackPanel>

					<!-- GUESTS -->
					<StackPanel Grid.Column="2">
						<TextBlock Text="Guests *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />

						<Border x:Name="GuestsBorder" Style="{StaticResource SpinnerBorderStyle}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="28"/>
								</Grid.ColumnDefinitions>

								<TextBox x:Name="GuestsBox" Text="" Style="{StaticResource SpinnerTextBoxStyle}"
                                         TextChanged="GuestsBox_TextChanged" />

								<TextBlock Text="Guests" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Visibility" Value="Collapsed"/>
											<Style.Triggers>
												<MultiDataTrigger>
													<MultiDataTrigger.Conditions>
														<Condition Binding="{Binding Text, ElementName=GuestsBox}" Value=""/>
														<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=GuestsBox}" Value="False"/>
													</MultiDataTrigger.Conditions>
													<Setter Property="Visibility" Value="Visible"/>
												</MultiDataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>

								<Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="*"/>
											<RowDefinition Height="*"/>
										</Grid.RowDefinitions>

										<Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Click="GuestsUp_Click">
											<Path Data="M2 4 L5 1 L8 4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Button>

										<Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
											<Button Style="{StaticResource SpinnerButtonStyle}" Click="GuestsDown_Click">
												<Path Data="M2 1 L5 4 L8 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Button>
										</Border>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<TextBlock x:Name="GuestsErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					</StackPanel>
				</Grid>


				<!-- TABLES -->
				<StackPanel Margin="0,0,0,16">
					<TextBlock Text="Tables *" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6" />

					<Border x:Name="TablesBorder" Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,10">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock x:Name="SelectedTablesText" Grid.Column="0" Text="Selected tables: 0 | Total seats: 0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" FontSize="13" />
							<Button x:Name="SelectTablesButton" Grid.Column="1" Content="Select Tables" Height="34" IsEnabled="False" Style="{StaticResource SelectTablesActionButtonStyle}" Click="SelectTables_Click" />
						</Grid>
					</Border>

					<TextBlock x:Name="TablesErrorText" Style="{StaticResource FieldErrorTextStyle}" />
					<TextBlock x:Name="CapacityWarningText" Foreground="#B45309" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
								Text="The number of guests exceeds the total seating capacity of the selected tables." />
				</StackPanel>


				<!-- NOTE -->
				<StackPanel Margin="0,0,0,8">
					<TextBlock Text="Note" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6" />

					<Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,10">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock x:Name="NoteText" Grid.Column="0" Text="No note added." VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
							<Button x:Name="AddNoteButton"
							        Grid.Column="1"
							        Content="Add Note"
							        Height="36"
							        HorizontalAlignment="Right"
							        VerticalAlignment="Center"
							        Background="{DynamicResource Surface}"
							        Foreground="{DynamicResource PrimaryText}"
							        BorderBrush="{DynamicResource Border}"
							        Style="{StaticResource SecondaryButtonStyle}"
							        Click="AddNote_Click" />
						</Grid>
					</Border>
				</StackPanel>

			</StackPanel>
		</controls:Dialog.DialogContent>


		<!-- FOOTER -->
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel"
				        Height="36"
				        Margin="0,0,8,0"
				        Background="#FFFFFF"
				        Foreground="{StaticResource PrimaryText}"
				        BorderBrush="{StaticResource Border}"
				        Click="Cancel_Click"
				        Style="{StaticResource SecondaryButtonStyle}" />
				<Button x:Name="SaveButton" Content="Add" Height="36" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
			</StackPanel>
		</controls:Dialog.FooterRight>

	</controls:Dialog>
</UserControl>