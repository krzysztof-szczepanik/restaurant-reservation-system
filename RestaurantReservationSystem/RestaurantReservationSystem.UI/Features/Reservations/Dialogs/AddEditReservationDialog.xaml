<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.AddEditReservationDialog">

    <UserControl.Resources>

        <!-- SPINNER TEXTBOX -->
        <Style x:Key="SpinnerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReservationFormTextBoxStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- SPINNER BORDER -->
        <Style x:Key="SpinnerBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SPINNER BUTTON -->
        <Style x:Key="SpinnerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <controls:Dialog x:Name="ReservationDialog" Header="Add Reservation" Width="520">

        <!-- CONTENT -->
        <controls:Dialog.DialogContent>
            <StackPanel>

                <!-- DATE AND TIME -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DATE -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />

                        <Grid>
                            <TextBox x:Name="DateBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,24,0" Style="{StaticResource ReservationFormTextBoxStyle}" />

                            <TextBlock Text="dd.MM.yyyy" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=DateBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DateBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5C3.89 4 3.01 4.9 3.01 6L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z" Fill="{StaticResource SecondaryText}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>

                    <!-- TIME -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />

                        <Grid>
                            <TextBox x:Name="TimeBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,24,0" Style="{StaticResource ReservationFormTextBoxStyle}" />

                            <TextBlock Text="HH:mm" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=TimeBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TimeBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Fill="{StaticResource SecondaryText}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </Grid>


                <!-- FIRST NAME AND LAST NAME -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="First Name" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
                        <TextBox x:Name="FirstNameBox" Height="36" VerticalContentAlignment="Center" Padding="12,0" Style="{StaticResource ReservationFormTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Last Name *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
                        <TextBox x:Name="LastNameBox" Height="36" VerticalContentAlignment="Center" Padding="12,0" Style="{StaticResource ReservationFormTextBoxStyle}" />
                    </StackPanel>
                </Grid>


                <!-- PHONE NUMBER AND GUESTS -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PHONE NUMBER -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phone Number" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />
                        <TextBox x:Name="PhoneBox" Height="36" VerticalContentAlignment="Center" Padding="12,0" Style="{StaticResource ReservationFormTextBoxStyle}" />
                    </StackPanel>

                    <!-- GUESTS -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Guests *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4" />

                        <Border x:Name="GuestsBorder" Style="{StaticResource SpinnerBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="GuestsBox" Text="1" Style="{StaticResource SpinnerTextBoxStyle}" />

                                <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Click="GuestsUp_Click">
                                            <Path Data="M2 4 L5 1 L8 4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                            <Button Style="{StaticResource SpinnerButtonStyle}" Click="GuestsDown_Click">
                                                <Path Data="M2 1 L5 4 L8 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>


                <!-- TABLES -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Tables *" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6" />

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SelectedTablesText" Grid.Column="0" Text="Selected tables: 0 | Total seats: 0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" FontSize="13" />
                            <Button Grid.Column="1" Content="Select Tables" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="SelectTables_Click" />
                        </Grid>
                    </Border>
                </StackPanel>


                <!-- NOTE -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Note" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6" />

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="NoteText" Grid.Column="0" Text="No note added." VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            <Button x:Name="NoteButton" Grid.Column="1" Content="Add Note" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="Note_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </controls:Dialog.DialogContent>


        <!-- FOOTER -->
        <controls:Dialog.FooterRight>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Height="36" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="SaveButton" Content="Add" Height="36" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </controls:Dialog.FooterRight>

    </controls:Dialog>
</UserControl>
