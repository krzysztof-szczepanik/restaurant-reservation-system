<Window x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.FilterResDial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" SizeToContent="WidthAndHeight">
    <Grid Background="#660F172A">
        <Border Background="{StaticResource Surface}" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Filtruj rezerwacje" FontSize="22" FontWeight="SemiBold" Margin="24,20"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20">
                    <TextBlock Text="Data od" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="FDateBox" Text="26.10.2026" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Data do" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TDateBox" Text="01.11.2026" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                        <Button Content="Wyczyść" Width="88" Margin="0,0,8,0" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Click="Clean_Click"/>
                        <Button Content="Zastosuj" Width="88" Click="Apply_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>