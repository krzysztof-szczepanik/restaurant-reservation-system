<UserControl x:Class="RestaurantReservationSystem.UI.Features.Tables.Dialogs.AddEditTableDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             PreviewKeyDown="UserControl_PreviewKeyDown">

	<UserControl.Resources>

		<!-- TEXTBOX -->
		<Style x:Key="FormTextBoxStyle" TargetType="TextBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
			<Setter Property="Background" Value="{DynamicResource Surface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- SPINNER TEXTBOX -->
		<Style x:Key="SpinnerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<!-- EDITABLE COMBOBOX -->
		<Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
			<Setter Property="Background" Value="{DynamicResource Surface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<Border x:Name="ComboBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>

							<!-- SELECTED TEXT -->
							<ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,36,0" VerticalAlignment="Center"/>

							<!-- EDITABLE TEXT -->
							<TextBox x:Name="PART_EditableTextBox" Style="{StaticResource SpinnerTextBoxStyle}" Margin="0,0,36,0" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>

							<!-- DROPDOWN BUTTON -->
							<ToggleButton Width="32" HorizontalAlignment="Right" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="Transparent">
											<Path Data="M1 1 L5 5 L9 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<!-- DROPDOWN -->
							<Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
								<Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
									<Border Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="6" Margin="0,4,0,0">
										<ScrollViewer Margin="4,6">
											<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
										</ScrollViewer>
									</Border>
								</Grid>
							</Popup>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsEditable" Value="True">
								<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
								<Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
							</Trigger>
							<Trigger Property="IsKeyboardFocusWithin" Value="True">
								<Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- SPINNER BORDER -->
		<Style x:Key="SpinnerBorderStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource Surface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Height" Value="36"/>
			<Style.Triggers>
				<Trigger Property="IsKeyboardFocusWithin" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- SPINNER BUTTON -->
		<Style x:Key="SpinnerButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{DynamicResource SecondaryHover}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- FIELD ERROR TEXT -->
		<Style x:Key="FieldErrorTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Danger}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="0,4,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Visibility" Value="Collapsed"/>
		</Style>

	</UserControl.Resources>

	<controls:Dialog x:Name="TableDialog" Header="Add Table" Width="480">

		<!-- CONTENT -->
		<controls:Dialog.DialogContent>
			<StackPanel x:Name="FieldsContainer">

				<!-- NUMBER -->
				<StackPanel x:Name="NumberPanel" Margin="0,0,0,16">
					<TextBlock x:Name="NumberLabel" Text="Number *" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>

					<Border x:Name="NumberBorder" Style="{StaticResource SpinnerBorderStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="28"/>
							</Grid.ColumnDefinitions>

							<TextBox x:Name="NumberBox" Style="{StaticResource SpinnerTextBoxStyle}" TextChanged="Field_TextChanged"/>

							<TextBlock Text="Number" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=NumberBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=NumberBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>

									<Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Click="NumberUp_Click">
										<Path Data="M2 4 L5 1 L8 4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Button>

									<Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
										<Button Style="{StaticResource SpinnerButtonStyle}" Click="NumberDown_Click">
											<Path Data="M2 1 L5 4 L8 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Button>
									</Border>
								</Grid>
							</Border>
						</Grid>
					</Border>

					<TextBlock x:Name="NumberErrorText" Style="{StaticResource FieldErrorTextStyle}"/>
				</StackPanel>

				<!-- LABEL -->
				<StackPanel x:Name="LabelPanel" Margin="0,0,0,16">
					<TextBlock x:Name="LabelFieldLabel" Text="Label" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
					<Grid>
						<TextBox x:Name="LabelBox" Style="{StaticResource FormTextBoxStyle}" TextChanged="Field_TextChanged"/>
						<TextBlock Text="Label" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding Text, ElementName=LabelBox}" Value=""/>
												<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=LabelBox}" Value="False"/>
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility" Value="Visible"/>
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
					<TextBlock x:Name="LabelErrorText" Style="{StaticResource FieldErrorTextStyle}"/>
				</StackPanel>

				<!-- ZONE -->
				<StackPanel x:Name="ZonePanel" Margin="0,0,0,16">
					<TextBlock x:Name="ZoneLabel" Text="Zone" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
					<Grid>
						<ComboBox x:Name="ZoneBox" Style="{StaticResource FormComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="False" TextBoxBase.TextChanged="Field_TextChanged"/>
						<TextBlock Text="Select or enter zone" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,36,0" IsHitTestVisible="False" FontSize="13">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding Text, ElementName=ZoneBox}" Value=""/>
												<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ZoneBox}" Value="False"/>
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility" Value="Visible"/>
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
					<TextBlock x:Name="ZoneErrorText" Style="{StaticResource FieldErrorTextStyle}"/>
				</StackPanel>

				<!-- SEATS -->
				<StackPanel x:Name="SeatsPanel" Margin="0,0,0,4">
					<TextBlock Text="Seats *" FontSize="13" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>

					<Border x:Name="SeatsBorder" Style="{StaticResource SpinnerBorderStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="28"/>
							</Grid.ColumnDefinitions>

							<TextBox x:Name="SeatsBox" Style="{StaticResource SpinnerTextBoxStyle}" TextChanged="Field_TextChanged"/>

							<TextBlock Text="Seats" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=SeatsBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SeatsBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>

									<Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Click="SeatsUp_Click">
										<Path Data="M2 4 L5 1 L8 4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Button>

									<Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
										<Button Style="{StaticResource SpinnerButtonStyle}" Click="SeatsDown_Click">
											<Path Data="M2 1 L5 4 L8 1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Button>
									</Border>
								</Grid>
							</Border>
						</Grid>
					</Border>

					<TextBlock x:Name="SeatsErrorText" Style="{StaticResource FieldErrorTextStyle}"/>
				</StackPanel>

			</StackPanel>
		</controls:Dialog.DialogContent>

		<!-- FOOTER RIGHT -->
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel"
                        Height="36"
                        Margin="0,0,8,0"
                        Background="#FFFFFF"
                        Foreground="{DynamicResource PrimaryText}"
                        BorderBrush="{DynamicResource Border}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>
				<Button x:Name="SaveButton"
                        Content="Add"
                        Height="36"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"/>
			</StackPanel>
		</controls:Dialog.FooterRight>

	</controls:Dialog>
</UserControl>