<Window x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.UnlockReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" 
        Background="Transparent" 
        AllowsTransparency="True" 
        SizeToContent="WidthAndHeight">

	<Grid Background="#660F172A">
		<Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="480">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20">
					<TextBlock Text="Unlock Reservation" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryText}"/>
				</Border>

				<StackPanel Grid.Row="1" Margin="24,24,24,32">
					<TextBlock FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4">
						<Run Text="This reservation is currently "/>
						<Run Text="Cancelled" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
						<Run Text=" or marked as "/>
						<Run Text="No show" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
						<Run Text="."/>
					</TextBlock>

					<TextBlock Text="Editing it requires unlocking the reservation." 
                               FontSize="13" 
                               Foreground="{StaticResource SecondaryText}" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,16"/>

					<TextBlock Text="After a successful save, the reservation status will change" 
                               FontSize="13" 
                               Foreground="{StaticResource SecondaryText}" 
                               TextWrapping="Wrap"/>

					<TextBlock FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap">
						<Run Text="to "/>
						<Run Text="Expected" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
						<Run Text="."/>
					</TextBlock>
				</StackPanel>

				<Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Cancel" Width="72" Height="36" Margin="0,0,8,0" 
                                Background="{StaticResource Surface}" 
                                Foreground="{StaticResource PrimaryText}" 
                                BorderBrush="{StaticResource Border}" 
                                BorderThickness="1" 
                                Click="Cancel_Click"/>

						<Button Content="Confirm" Width="72" Height="36" 
                                Background="{StaticResource Primary}" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Click="Confirm_Click"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>