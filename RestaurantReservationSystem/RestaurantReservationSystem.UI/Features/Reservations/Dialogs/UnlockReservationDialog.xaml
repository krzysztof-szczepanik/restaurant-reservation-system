<UserControl x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.UnlockReservationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">
	<controls:Dialog Header="Unlock Reservation" Width="480">
		<controls:Dialog.DialogContent>
			<StackPanel>
				<TextBlock Text="Are you sure you want to unlock this reservation?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
				<TextBlock Text="You need to verify table availability before restoring the reservation." FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
			</StackPanel>
		</controls:Dialog.DialogContent>
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
				<Button Content="Confirm" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
			</StackPanel>
		</controls:Dialog.FooterRight>
	</controls:Dialog>
</UserControl>