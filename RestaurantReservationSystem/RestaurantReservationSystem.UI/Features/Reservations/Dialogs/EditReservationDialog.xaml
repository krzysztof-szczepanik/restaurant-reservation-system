<Window x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.EditResDial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" SizeToContent="WidthAndHeight">
    <Grid Background="#660F172A">
        <Border Background="{StaticResource Surface}" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="560">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Edytuj rezerwację" FontSize="22" FontWeight="SemiBold" Margin="24,20"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Data *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="DateBox" Text="28.10.2026" Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Godzina *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="HoursBox" Text="18:30" Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Imię" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="FNameBox" Text="Anna" Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Nazwisko *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="LNameBox" Text="Kowalska" Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Numer telefonu" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="PhoneBox" Text="555 123 456" Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Osoby *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="GuestsBox" Text="4" Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Stoliki *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource Background}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="Wybrany stolik: 1 (T01) | Liczba miejsc: 4" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                            <Button Content="Wybierz stolik" Width="125" HorizontalAlignment="Left" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="358,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Notatka" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource Background}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <TextBlock Text="Proszę o miejsce przy oknie" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                            <Button Content="Edytuj notatkę" Width="130" HorizontalAlignment="Left" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="354,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                        <Button Content="Anuluj" Width="88" Margin="0,0,8,0" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Click="Cancel_Click"/>
                        
                        <Button Content="Zapisz" Width="88" Click="Zapisz_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>