<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.SelectZonesDialog">

	<controls:Dialog Header="Select Zones" Width="480">
		<controls:Dialog.DialogContent>
			<ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel>
					<StackPanel Margin="0,0,0,16">

						<Grid Margin="0,0,0,16">
							<TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center" Padding="12,0" Style="{StaticResource ReservationFormTextBoxStyle}" TextChanged="SearchBox_TextChanged"/>
							<TextBlock Text="Search zones" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" FontSize="13">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
													<Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Visible"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>

						<Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Height="220">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<StackPanel x:Name="ZonesPanel"/>
							</ScrollViewer>
						</Border>
					</StackPanel>

					<TextBlock x:Name="SelectedZonesSummaryText" Text="Selected zones: 0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Left" />
				</StackPanel>
			</ScrollViewer>
		</controls:Dialog.DialogContent>

		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel" Height="36" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" />
				<Button Content="Confirm" Height="36" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" />
			</StackPanel>
		</controls:Dialog.FooterRight>
	</controls:Dialog>
</UserControl>