<UserControl x:Class="RestaurantReservationSystem.UI.Controls.Sidebar.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,24,0,16">
                <TextBlock TextWrapping="Wrap" Margin="24,0,24,24" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryText}">Restaurant<LineBreak/>Reservation System</TextBlock>
                <Border Height="1" Margin="16,0,16,0" Background="{StaticResource Border}"/>
            </StackPanel>

            <!-- NAVIGATION -->
            <StackPanel Grid.Row="1" Margin="16,0">

                <!-- TODAY -->
                <RadioButton x:Name="TodayNavigationButton" GroupName="SidebarNavigation" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" IsChecked="True" Checked="Today_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6z M16 2v4 M8 2v4 M4 10h16 M8 14h.01 M12 14h.01 M16 14h.01 M8 18h.01 M12 18h.01 M16 18h.01"/>
                        <TextBlock Text="Today" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- RESERVATIONS -->
                <RadioButton GroupName="SidebarNavigation" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Checked="Reservations_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6z M16 2v4 M8 2v4 M4 10h16 M7 14h5 M15 14h1 M7 18h1 M11 18h5"/>
                        <TextBlock Text="Reservations" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- TABLES -->
                <RadioButton GroupName="SidebarNavigation" Style="{StaticResource SidebarButtonStyle}" Checked="Tables_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3 M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0Z M5 18v2 M19 18v2"/>
                        <TextBlock Text="Tables" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- SETTINGS -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <Border Height="1" Margin="16,0,16,16" Background="{StaticResource Border}"/>

                <RadioButton GroupName="SidebarNavigation" Style="{StaticResource SidebarButtonStyle}" Margin="16,0,16,0" Checked="Settings_Checked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>