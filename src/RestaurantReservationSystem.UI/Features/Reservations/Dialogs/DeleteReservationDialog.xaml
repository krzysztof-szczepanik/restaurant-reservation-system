<UserControl x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.DeleteReservationsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">

	<controls:Dialog Header="Delete Reservation" Width="480">

		<!-- CONTENT -->
		<controls:Dialog.DialogContent>
			<StackPanel>
				<TextBlock Text="Delete this reservation?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
				<TextBlock Text="This action cannot be undone." FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
			</StackPanel>
		</controls:Dialog.DialogContent>

		<!-- FOOTER RIGHT -->
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel"
				        Height="36"
				        Margin="0,0,8,0"
				        Background="#FFFFFF"
				        Foreground="{StaticResource PrimaryText}"
				        BorderBrush="{StaticResource Border}"
				        Style="{StaticResource SecondaryButtonStyle}"
				        Click="Cancel_Click"/>
				<Button Content="Delete"
				        Height="36"
				        Style="{StaticResource DangerButtonStyle}"
				        Click="Delete_Click"/>
			</StackPanel>
		</controls:Dialog.FooterRight>

	</controls:Dialog>
</UserControl>