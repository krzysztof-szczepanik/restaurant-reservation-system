<Window x:Class="RestaurantReservationSystem.UI.Features.Tables.Dialogs.CannotDeleteTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" 
        Background="Transparent" 
        AllowsTransparency="True" 
        SizeToContent="WidthAndHeight">

	<Grid Background="#660F172A">
		<Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="480">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20">
					<TextBlock Text="Cannot Delete Table" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryText}"/>
				</Border>

				<StackPanel Grid.Row="1" Margin="24,24,24,32">
					<TextBlock Text="This table cannot be deleted" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,8"/>

					<TextBlock Text="Because it is assigned to reservations." 
                               FontSize="13" 
                               Foreground="{StaticResource SecondaryText}" 
                               TextWrapping="Wrap"/>
				</StackPanel>

				<Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="OK" Width="72" Height="36" 
                                Background="{StaticResource Primary}" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Click="Ok_Click"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>