<UserControl x:Class="RestaurantReservationSystem.UI.Features.Reservations.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="992">

	<UserControl.Resources>
		<Style x:Key="ReservationsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
			<Setter Property="Foreground" Value="#334155"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Opacity" Value="1"/>
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Foreground" Value="#8A99AD"/>
					<Setter Property="BorderBrush" Value="#DCE3EC"/>
					<Setter Property="Background" Value="#F8FAFC"/>
					<Setter Property="Opacity" Value="1"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Grid Background="Transparent" MouseDown="MainGrid_MouseDown">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<Border Grid.Row="0" Style="{StaticResource ViewHeaderStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- TITLE AND ACTIONS -->
				<Grid Grid.Row="0">
					<TextBlock Text="Reservations" Style="{StaticResource ViewTitleStyle}"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
						<Button Content="Add" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="AddReservations_Click"/>
						<Button x:Name="EditButton" Content="Edit" Margin="0,0,8,0" IsEnabled="False" Style="{StaticResource ReservationsActionButtonStyle}" Click="EditReservations_Click"/>
						<Button x:Name="DeleteButton" Content="Delete" IsEnabled="False" Style="{StaticResource ReservationsActionButtonStyle}" Click="DeleteReservations_Click"/>
					</StackPanel>
				</Grid>

				<!-- SEARCH AND FILTER -->
				<Grid Grid.Row="1" Margin="0,20,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- SEARCH -->
					<TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchTextBoxStyle}" TextChanged="SearchBox_TextChanged"/>

					<!-- FILTER -->
					<Button x:Name="FilterButton" Grid.Column="2" Content="Filter" Tag="False" Style="{StaticResource FilterButtonStyle}" Click="Filter_Click"/>
				</Grid>
			</Grid>
		</Border>

		<!-- CONTENT -->
		<Border Grid.Row="1" Style="{StaticResource ViewContentStyle}">
			<controls:DataTable x:Name="ReservationsDataGrid"
			                    EmptyMessage="No reservations yet."
			                    PreviewMouseLeftButtonDown="ReservationsDataGrid_PreviewMouseLeftButtonDown"
			                    SelectionChanged="ReservationsDataGrid_SelectionChanged">
				<controls:DataTable.Columns>
					<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="1.1*"/>
					<DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:HH\:mm}}" Width="0.8*"/>
					<DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="1.1*" Visibility="Collapsed"/>
					<DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="1.1*" Visibility="Collapsed"/>
					<DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneDisplay}" Width="1.3*" Visibility="Collapsed"/>
					<DataGridTextColumn Header="Guests" Binding="{Binding Guests}" Width="0.8*"/>
					<DataGridTextColumn Header="Tables" Binding="{Binding TablesDisplay}" Width="1.6*">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="Background" Value="Transparent"/>
								<Setter Property="ToolTip" Value="{Binding TablesTooltip}"/>
								<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Header="Note" Binding="{Binding NoteDisplay}" Width="2*">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="Background" Value="Transparent"/>
								<Setter Property="ToolTip" Value="{Binding NoteTooltip}"/>
								<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
				</controls:DataTable.Columns>
			</controls:DataTable>
		</Border>
	</Grid>
</UserControl>