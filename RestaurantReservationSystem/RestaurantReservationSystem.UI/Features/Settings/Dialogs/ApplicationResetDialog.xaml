<Window x:Class="RestaurantReservationSystem.UI.Features.Ustawienia.Dialogs.AppResDial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" 
        Background="Transparent" 
        AllowsTransparency="True" 
        SizeToContent="WidthAndHeight">

    <Grid Background="#660F172A">
        <Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Danger}" 
                BorderThickness="2" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                MinWidth="450">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Resetowanie aplikacji" 
                               FontSize="22" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource Danger}"
                               Margin="24,20"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,24,24,32">
                    <TextBlock Text="Czy na pewno chcesz zresetować aplikację?" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Wszystkie dane (rezerwacje, stoliki) zostaną trwale usunięte. 
                               Nastąpi przekierowanie do ekranu konfiguracji początkowej. Tej operacji nie można cofnąć." 
                               FontSize="14" 
                               Foreground="{StaticResource SecondaryText}" 
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                        <Button Content="Anuluj" Width="88" Margin="0,0,8,0" 
                                Background="{StaticResource Surface}" 
                                Foreground="{StaticResource Text}" 
                                BorderBrush="{StaticResource Border}" 
                                BorderThickness="1" 
                                Click="Cancel_Click"/>

                        <Button Content="Tak, resetuj" Width="105" 
                                Background="{StaticResource Danger}" 
                                Click="Reset_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>