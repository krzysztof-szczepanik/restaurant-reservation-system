<Window x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.FilterResDial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" SizeToContent="WidthAndHeight">
	<Grid Background="#660F172A">
		<Border Background="{StaticResource Surface}" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20">
					<TextBlock Text="Filter Reservations" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
				</Border>

				<StackPanel Grid.Row="1" Margin="24,20">

					<Grid Margin="0,0,0,4">
						<TextBlock Text="Date" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Border Background="{StaticResource Surface}" CornerRadius="3" Padding="8,3">
									<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
								</Border>
								<Border Background="Transparent" CornerRadius="3" Padding="8,3">
									<TextBlock Text="Range" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
					<Grid Height="36" Margin="0,0,0,16">
						<TextBox x:Name="FDateBox" Text="23.10.2026" VerticalContentAlignment="Center" Padding="12,0,36,0" Foreground="{StaticResource PrimaryText}"/>
						<Path Data="M19 4h-1V2h-2v2H8V2H6v2H5C3.89 4 3.01 4.9 3.01 6L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM7 6h2v2H7V6zm4 0h2v2h-2V6zm4 0h2v2h-2V6z" 
                              Fill="White" Stroke="{StaticResource SecondaryText}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False"/>
					</Grid>

					<Grid Margin="0,0,0,4">
						<TextBlock Text="Time" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Border Background="{StaticResource Surface}" CornerRadius="3" Padding="8,3">
									<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
								</Border>
								<Border Background="Transparent" CornerRadius="3" Padding="8,3">
									<TextBlock Text="Range" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
					<Grid Height="36" Margin="0,0,0,16">
						<TextBox Text="18:30" VerticalContentAlignment="Center" Padding="12,0,36,0" Foreground="{StaticResource PrimaryText}"/>
						<Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" 
                              Fill="White" Stroke="{StaticResource SecondaryText}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False"/>
					</Grid>

					<Grid Margin="0,0,0,4">
						<TextBlock Text="Guests" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Border Background="{StaticResource Surface}" CornerRadius="3" Padding="8,3">
									<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
								</Border>
								<Border Background="Transparent" CornerRadius="3" Padding="8,3">
									<TextBlock Text="Range" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock Text="Exact" FontSize="11" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
					<TextBox Text="6" Height="36" VerticalContentAlignment="Center" Padding="12,0" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,16"/>

					<Grid Margin="0,0,0,8">
						<TextBlock Text="Zone" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Border Background="{StaticResource Surface}" CornerRadius="3" Padding="10,3">
									<TextBlock Text="OR" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
								</Border>
								<Border Background="Transparent" CornerRadius="3" Padding="10,3">
									<TextBlock Text="AND" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
					<Grid Height="52" Margin="0,0,0,16">
						<Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12,0">
							<TextBlock Text="Selected zones: 1" VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}" FontSize="13" FontWeight="SemiBold"/>
						</Border>
						<Button Content="Select Zones" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" Height="36" Margin="0,0,6,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Foreground="{StaticResource PrimaryText}"/>
					</Grid>

					<Grid Margin="0,0,0,8">
						<TextBlock Text="Tables" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
						<Border Background="#F1F5F9" CornerRadius="4" Padding="2" HorizontalAlignment="Right">
							<StackPanel Orientation="Horizontal">
								<Border Background="{StaticResource Surface}" CornerRadius="3" Padding="10,3">
									<TextBlock Text="OR" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
								</Border>
								<Border Background="Transparent" CornerRadius="3" Padding="10,3">
									<TextBlock Text="AND" FontSize="11" Foreground="{StaticResource SecondaryText}"/>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
					<Grid Height="52">
						<Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12,0">
							<TextBlock Text="Selected tables: 1" VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}" FontSize="13" FontWeight="SemiBold"/>
						</Border>
						<Button Content="Select Tables" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" Height="36" Margin="0,0,6,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Foreground="{StaticResource PrimaryText}"/>
					</Grid>
				</StackPanel>

				<Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16">
					<Grid>
						<Button Content="Reset" Width="72" Height="36" HorizontalAlignment="Left" Background="{StaticResource Surface}" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource Border}" BorderThickness="1" Click="Clean_Click"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button Content="Cancel" Width="72" Height="36" Margin="0,0,8,0" Background="{StaticResource Surface}" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource Border}" BorderThickness="1"/>
							<Button Content="Apply" Width="72" Height="36" Background="{StaticResource Primary}" Foreground="White" BorderThickness="0" Click="Apply_Click"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>