<Window x:Class="RestaurantReservationSystem.UI.Features.Reservations.Dialogs.AddResDial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" 
        Background="Transparent" 
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight">

	<Grid Background="#660F172A">
		<Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="520">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20">
					<TextBlock Text="Add Reservation" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryText}"/>
				</Border>

				<ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="24,20">

						<Grid Margin="0,0,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Date *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
								<Grid>
									<TextBox x:Name="DateBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,36,0"/>
									<TextBlock Text="dd.MM.yyyy" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" FontSize="13">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding Text, ElementName=DateBox}" Value="">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Path Data="M19 4h-1V2h-2v2H8V2H6v2H5C3.89 4 3.01 4.9 3.01 6L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z" 
                                          Fill="{StaticResource SecondaryText}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
								</Grid>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Time *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
								<Grid>
									<TextBox x:Name="TimeBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,36,0"/>
									<TextBlock Text="HH:mm" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" FontSize="13">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding Text, ElementName=TimeBox}" Value="">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" 
                                          Fill="{StaticResource SecondaryText}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
								</Grid>
							</StackPanel>
						</Grid>

						<Grid Margin="0,0,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="First Name" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
								<TextBox x:Name="FirstNameBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,12,0"/>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Last Name *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
								<TextBox x:Name="LastNameBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,12,0"/>
							</StackPanel>
						</Grid>

						<Grid Margin="0,0,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Phone Number" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
								<TextBox x:Name="PhoneBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,12,0"/>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Guests *" FontSize="13" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
								<TextBox x:Name="GuestsBox" Height="36" VerticalContentAlignment="Center" Padding="12,0,12,0"/>
							</StackPanel>
						</Grid>

						<StackPanel Margin="0,0,0,16">
							<TextBlock Text="Tables *" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6"/>
							<Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,14" Background="#F8FAFC">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Selected tables: 0 | Total seats: 0" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource PrimaryText}"/>
									<Button Grid.Column="1" Content="Select Tables" Width="112" Height="34" 
                                            Background="#F1F5F9" 
                                            Foreground="#475569" 
                                            BorderBrush="#CBD5E1" 
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Click="SelectTables_Click"/>
								</Grid>
							</Border>
						</StackPanel>

						<StackPanel Margin="0,0,0,8">
							<TextBlock Text="Note" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,6"/>
							<Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,14" Background="#F8FAFC">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="No note added." VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryText}"/>
									<Button Grid.Column="1" Content="Add Note" Width="92" Height="34" 
                                            Background="{StaticResource Surface}" 
                                            Foreground="{StaticResource PrimaryText}" 
                                            BorderBrush="{StaticResource Border}" 
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Click="AddNote_Click"/>
								</Grid>
							</Border>
						</StackPanel>

					</StackPanel>
				</ScrollViewer>

				<Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Content="Cancel" Width="72" Height="36" Margin="0,0,8,0" 
                                Background="{StaticResource Surface}" 
                                Foreground="{StaticResource PrimaryText}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Click="Cancel_Click"/>
						<Button Content="Add" Width="72" Height="36" 
                                Background="{StaticResource Primary}" 
                                Foreground="White"
                                BorderThickness="0"
                                Click="Save_Click"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>