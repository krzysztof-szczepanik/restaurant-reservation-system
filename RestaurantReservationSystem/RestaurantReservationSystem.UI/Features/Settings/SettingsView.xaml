<UserControl x:Class="RestaurantReservationSystem.UI.Features.Ustawienia.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">

    <Grid Height="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,0">
            <TextBlock Text="Ustawienia" 
                       FontSize="32" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,0,24,24">

            <TextBlock Text="Zarządzanie danymi" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border Background="{StaticResource Surface}" 
                    BorderBrush="{StaticResource Border}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Resetowanie do ustawień fabrycznych" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Spowoduje to trwałe usunięcie wszystkich rezerwacji, stolików i ustawień. Aplikacja zostanie przywrócona do stanu początkowego." 
                                   Foreground="{StaticResource SecondaryText}" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="Resetuj dane" 
                            Width="120" 
                            Height="36" 
                            Background="{StaticResource Danger}" 
                            Foreground="{StaticResource Surface}"
                            Click="Reset_Click" Margin="5,87,5,-82"/>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>