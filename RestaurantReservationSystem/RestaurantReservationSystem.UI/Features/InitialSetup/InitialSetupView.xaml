<UserControl x:Class="RestaurantReservationSystem.UI.Features.InitialSetup.InitialSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

        <Border Background="{StaticResource Surface}" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="40"
                Width="500">

            <StackPanel>

                <TextBlock Text="KONFIGURACJA SYSTEMU"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Twoja restauracja"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="{StaticResource Primary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <TextBlock Text="Uzupełnij podstawowe informacje, aby rozpocząć zarządzanie rezerwacjami."
                           FontSize="14"
                           Foreground="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="8,0,8,28"/>

                <TextBlock Text="Nazwa restauracji *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Text="np. Restauracja Pod Aniołami" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adres e-mail" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmailBox" Text="kontakt@restauracja.pl" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Numer telefonu *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="PhoneBox" Text="500 600 700" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Godziny otwarcia" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="HoursBox" Text="np. Pon-Nd 12:00 - 22:00" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,32"/>

                <Button Content="Zakończ konfigurację" 
                        Height="48" 
                        FontSize="16" 
                        Click="Submit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>