<Window x:Class="RestaurantReservationSystem.UI.Features.Stoliki.Dialogs.EditTabDial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" 
        Background="Transparent" 
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight">

    <Grid Background="#660F172A">

        <Border Background="{StaticResource Surface}" 
                CornerRadius="6" 
                BorderBrush="{StaticResource Border}" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MinWidth="400">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Edytuj stolik" 
                               FontSize="22" 
                               FontWeight="SemiBold" 
                               Margin="24,20"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20">

                    <TextBlock Text="Numer stolika *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="NumberBox" Text="T01" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Etykieta" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="LabelBox" Text="Miejsce przy oknie" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Strefa" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ZoneBox" Height="38" Margin="0,0,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="Sala główna"/>
                        <ComboBoxItem Content="Taras"/>
                        <ComboBoxItem Content="Brak strefy"/>
                    </ComboBox>

                    <TextBlock Text="Liczba miejsc *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="SeatsBox" Text="4" Foreground="{StaticResource SecondaryText}"/>

                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">

                        <Button Content="Anuluj" Width="88" Margin="0,0,8,0" 
                                Background="{StaticResource Surface}" 
                                Foreground="{StaticResource Text}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Click="Cancel_Click"/>

                        <Button Content="Zapisz" Width="88" Click="Zapisz_Click"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>