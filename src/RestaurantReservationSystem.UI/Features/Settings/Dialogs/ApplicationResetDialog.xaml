<UserControl x:Class="RestaurantReservationSystem.UI.Features.Settings.Dialogs.ApplicationResetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RestaurantReservationSystem.UI.Controls">

	<controls:Dialog Header="Reset Application" Width="480">

		<!-- CONTENT -->
		<controls:Dialog.DialogContent>
			<StackPanel>
				<TextBlock Text="Are you sure you want to reset the application?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
				<TextBlock FontSize="13" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap">
                    <Run Text="This action will permanently delete all reservations, tables," />
                    <LineBreak />
                    <Run Text="and the initial configuration. This cannot be undone." />
				</TextBlock>
			</StackPanel>
		</controls:Dialog.DialogContent>

		<!-- FOOTER RIGHT -->
		<controls:Dialog.FooterRight>
			<StackPanel Orientation="Horizontal">
				<Button Content="Cancel"
                        Height="36"
                        Margin="0,0,8,0"
                        Background="#FFFFFF"
                        Foreground="{StaticResource PrimaryText}"
                        BorderBrush="{StaticResource Border}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>
				<Button Content="Reset"
                        Height="36"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="Reset_Click"/>
			</StackPanel>
		</controls:Dialog.FooterRight>

	</controls:Dialog>
</UserControl>